# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth is configured in the Supabase dashboard (Authentication → Providers),
# not via Next.js env vars. Authorized redirect URI:
# https://YOUR_PROJECT.supabase.co/auth/v1/callback

# Stripe
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=REPLACE_ME
STRIPE_PRICE_PRO_LIFETIME=REPLACE_ME
